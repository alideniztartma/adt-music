            android:targetClass="com.alideniz.adtmusic.MainActivity">
            <extra android:name="shortcut" android:value="shuffle_liked" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="daily"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_mix"
        android:shortcutShortLabel="@string/shortcut_daily">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="com.alideniz.adtmusic"
            android:targetClass="com.alideniz.adtmusic.MainActivity">
            <extra android:name="shortcut" android:value="daily" />
